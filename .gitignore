.env
.env.owner
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/

# Los reportes de ronda SÍ se versionan: son el archivo, y el archivo no es
# opcional. Solo se ignora lo que es puramente local.
runs/*.tmp

# La bandeja es un buzón, no corpus. Lo ingerido vive en artefactos/corpus/.
artefactos/entrada/*
!artefactos/entrada/.gitkeep
