# Copia a .env y rellena. `make up` lo hace por ti si no existe.
#
# El sistema ARRANCA ENTERO SIN NINGUNA CLAVE: con EMBEDDINGS_PROVIDER y
# LLM_PROVIDER en `mock` la ingesta y la recuperación funcionan de punta a
# punta con embeddings deterministas. Los parecidos no significan nada, pero
# el pipeline sí, y eso es lo que hace que la señal de nivel 0 corra en CI.

# --- proveedores ---------------------------------------------------------
# mock | openai   — el proveedor entra en la huella INDEX_BOUND, así que un
# índice construido en mock NUNCA puede confundirse con uno real.
EMBEDDINGS_PROVIDER=mock
# mock | anthropic
LLM_PROVIDER=mock

# --- modelos -------------------------------------------------------------
# Los tres papeles usan familias DISJUNTAS y hay un assert que revienta el
# import si dos coinciden: el auto-reconocimiento causa auto-preferencia, y
# atlas-rai tiene ese defecto por defecto (modelo == modelo_juez).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Solo si pones reranker="cohere". Es palanca de grada 2, de las que el bucle
# mueve sin pedir permiso, así que conviene tenerla resuelta antes de que la
# mueva. Con reranker="local" no hace falta clave: `make extras`.
COHERE_API_KEY=

# --- base de datos -------------------------------------------------------
DATABASE_URL=postgresql+psycopg://ai:ai@localhost:5533/ai

# El holdout vive en su propio esquema y el rol de arriba NO puede leerlo.
# Esta credencial se usa solo en `make holdout` y NO la ve el coding agent
# (.claude/settings.json deniega la lectura de .env y de .env.owner).
# Vive en .env.owner, no aquí.

# --- AgentOS -------------------------------------------------------------
AGENTOS_HOST=127.0.0.1
AGENTOS_PORT=7788
